{
  "pluginAlias": "ConnectLifeAircon",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "ConnectLife Aircon",
  "footerDisplay": "Configure your ConnectLife Aircon appliances by name.",
  "schema": {
    "type": "object",
    "required": ["name","email", "password", "appliances"],
    "properties": {
      "name": {
        "title": "Plugin Name",
        "type": "string",
        "default": "ConnectLife Aircon",
        "description": "ConnectLife account email"
      },
      "email": {
        "title": "Email",
        "type": "string",
        "format": "email",
        "description": "ConnectLife account email"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "format": "password",
        "description": "ConnectLife account password"
      },
      "pollIntervalSeconds": {
        "title": "Polling interval",
        "type": "integer",
        "default": 30,
        "minimum": 15,
        "maximum": 900,
        "description": "Seconds between successful ConnectLife status updates. Errors use automatic backoff."
      },
      "diagnosticLogging": {
        "title": "HomeKit service diagnostics",
        "type": "boolean",
        "default": false,
        "description": "Log cached HomeKit service and characteristic names without values or cloud credentials."
      },
      "appliances": {
        "title": "Appliances",
        "type": "array",
        "description": "List of appliances to expose (by exact name)",
        "items": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "title": "Appliance Name",
              "type": "string",
              "description": "Exact appliance name as shown in ConnectLife (case-sensitive)"
            },
            "timer": {
              "title": "Shutdown timer",
              "type": "object",
              "properties": {
                "enabled": {
                  "title": "Enable timer switch",
                  "type": "boolean",
                  "default": false
                },
                "durationMinutes": {
                  "title": "Timer duration in minutes",
                  "type": "integer",
                  "default": 60,
                  "minimum": 1,
                  "maximum": 10080
                },
                "turnOnWhenStarted": {
                  "title": "Turn on AC when timer starts",
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        }
      }
    }
  }
}
